# ローカル開発用の環境変数テンプレート（値はダミー。実値は .env.local に記載）
# 仕様: docs/spec/framework-drivers-layer.md#環境変数必須推奨

# DB パス（任意。未設定時は db/data/*.db）
# TUTOR_DB_PATH=db/data/tutor.db
# LEARNING_DB_PATH=db/data/learning.db

# DB の複製(Litestream → GCS)。コンテナ(deploy/entrypoint.sh)の起動でだけ読まれる。
# `uv run flask ...` でのローカル起動では使われない。コンテナをローカルで動かすときだけ、
# 複製しないことを明示する(未指定かつ DB_REPLICA_BUCKET も空だと起動を失敗させる)。
# DB_REPLICA_DISABLED=1
# Cloud Run では DB_REPLICA_BUCKET(バケット名のみ。gs:// なし)を設定する。
# DB_REPLICA_BUCKET=your-replica-bucket

# Gemini Enterprise Agent Platform（旧 Vertex AI、AI 利用時）
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json
VERTEX_PROJECT_ID=your-project-id
VERTEX_LOCATION=asia-northeast1
# VERTEX_MODEL_NAME=gemini-2.5-flash

# YouTube 動画長取得（Phase 2 以降）
YOUTUBE_API_KEY=your-youtube-api-key

# 学内プロキシ経由が必要な場合のみ true（学外では行ごとコメントアウト、または false を明示）
# USE_HTTP_PROXY=true
# HTTP_PROXY=http://gw.a.tsukuba-tech.ac.jp:8080
# HTTPS_PROXY=http://gw.a.tsukuba-tech.ac.jp:8080
# 学外の例: USE_HTTP_PROXY=false
