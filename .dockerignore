# Git / Python 仮想環境
.git/
.venv/
**/__pycache__/
.pytest_cache/

# 秘密情報（仕様: docs/spec/framework-drivers-layer.md#ローカル秘密情報what）
secrets/
*.json
.env
.env.*
!.env.example
Key.txt

# ローカル DB（コンテナ内で再初期化）
db/data/*.db

# テスト・開発用スクリプト・ドキュメント
tests/
scripts/
docs/
.cursor/

# レガシー資産（ランタイム不要）
lecture_video_platform/
quiz_form/
infrastructure/
app/
Architecture/

# ランタイム不要の字幕校正の作業資料（実行時に読むのは subtitles.srt と subtitles.display.srt のみ）
lectures/**/subtitles.proofread.srt
lectures/**/proofread-diff.md
lectures/**/display-fillers.md

# その他開発用
node_modules/

# dev-team / コンテナのビルドに送らない
.claude/
